---
// src/components/docs/SampleData.astro
import { Download, Terminal } from 'lucide-react';

interface Props {
  file: string;
  rows: number;
  label: string;
}

const { file, rows, label } = Astro.props;
---

<div class="not-prose my-6 rounded-2xl border border-dark-700/80 bg-dark-900/90 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 backdrop-blur-md shadow-lg">
  <div class="flex-1 min-w-[220px]">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-moro-400"></span>
      <p class="text-sm font-bold text-white tracking-tight">{label}</p>
    </div>
    <p class="text-xs text-gray-400 mt-1">
      <span class="font-mono text-moro-300 font-semibold">{rows} sample rows</span> · JSONL format · CC-BY-4.0 · pre-validated for <code class="text-moro-400 bg-dark-950 px-1.5 py-0.5 rounded border border-dark-800">moro data build</code>
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <a
      href={`/downloads/${file}`}
      download
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-moro-500 hover:bg-moro-400 text-white text-xs font-semibold shadow-md shadow-moro-500/20 transition-all hover:scale-105"
    >
      <Download class="w-3.5 h-3.5" />
      <span>Download .jsonl</span>
    </a>
    <div class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-dark-950 border border-dark-800 text-[11px] text-gray-400 font-mono">
      <Terminal class="w-3 h-3 text-gray-500" />
      <span>curl -O https://moroai.cc/downloads/{file}</span>
    </div>
  </div>
</div>
