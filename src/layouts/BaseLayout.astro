---
import '../styles/global.css';
import Header from '../components/navigation/Header';
import Footer from '../components/navigation/Footer';
import OGMeta from '../components/OGMeta.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  readingTime?: string;
  category?: string;
}

const {
  title,
  description = 'MoroAI — Local-First Private AI Model Adaptation Foundry',
  path = Astro.url.pathname,
  image,
  ogImage = image || `/og/${path === '/' ? 'home' : path.replace(/^\/|\/$/g, '').replace(/\//g, '__')}.png`,
  ogType,
  type = ogType || 'website',
  publishedTime,
  modifiedTime,
  author = 'aljagne',
  tags = ['LocalAI', 'LLM Fine-Tuning', 'Sovereign AI', 'Open Source'],
  readingTime,
  category,
} = Astro.props;

// Merge category into tags if present
const finalTags = category ? [category, ...tags] : tags;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <OGMeta
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={finalTags}
      readingTime={readingTime}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-dark-950 text-gray-100 min-h-screen flex flex-col font-sans antialiased selection:bg-moro-500/30 selection:text-moro-200">
    <Header client:load />

    <div class="flex-1">
      <slot />
    </div>

    <Footer client:load />
  </body>
</html>
