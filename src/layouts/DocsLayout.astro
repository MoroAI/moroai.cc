---
import BaseLayout from './BaseLayout.astro';
import MobileDocsNav from '../components/docs/MobileDocsNav';
import {
  BookOpen,
  ChevronRight,
  ArrowLeft,
  ArrowRight,
  Home,
  Check
} from 'lucide-react';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Official MoroAI Documentation',
  currentSlug = Astro.url.pathname,
  ogImage,
} = Astro.props;

const docNav = [
  {
    category: 'Getting Started',
    items: [
      { label: 'Introduction', href: '/docs/getting-started/introduction/' },
      { label: 'Installation', href: '/docs/getting-started/installation/' },
      { label: 'Quickstart (5 min)', href: '/docs/getting-started/quickstart/' },
      { label: 'Your First Model', href: '/docs/getting-started/first-model/' },
    ],
  },
  {
    category: 'Architecture Deep-Dive',
    items: [
      { label: 'System Overview', href: '/docs/concepts/overview/' },
      { label: 'Epistemic Data Compiler', href: '/docs/concepts/data-compiler/' },
      { label: 'PPMI & Information Content', href: '/docs/concepts/ppci-filtering/' },
      { label: 'Lineage Graphs & Provenance', href: '/docs/concepts/lineage-graphs/' },
      { label: 'Hardware Recipe Engine', href: '/docs/concepts/recipe-engine/' },
      { label: 'Self-Healing Training Engine', href: '/docs/concepts/training-engine/' },
      { label: 'Multi-Layer Eval Harness', href: '/docs/concepts/eval-harness/' },
      { label: 'Statistical Drift Detection', href: '/docs/concepts/drift-detection/' },
      { label: 'DPO Feedback Flywheel', href: '/docs/concepts/flywheel/' },
      { label: 'Release Governance & SBOM', href: '/docs/concepts/governance/' },
      { label: 'Mission Control UI', href: '/docs/concepts/dashboard/' },
    ],
  },
  {
    category: 'Cookbook & Real-World Examples',
    items: [
      { label: 'Cookbook Overview', href: '/docs/cookbook/' },
      { label: 'Customer Support Bot', href: '/docs/cookbook/support-bot/' },
      { label: 'Structured JSON Extractor', href: '/docs/cookbook/json-extractor/' },
      { label: 'Code Assistant', href: '/docs/cookbook/code-assistant/' },
      { label: 'Document Summarizer', href: '/docs/cookbook/document-summarizer/' },
      { label: 'Medical Q&A System', href: '/docs/cookbook/medical-qa/' },
      { label: 'Legal Document Analyzer', href: '/docs/cookbook/legal-analyzer/' },
    ],
  },
  {
    category: 'CLI Reference',
    items: [
      { label: 'CLI Overview', href: '/docs/cli/' },
      { label: 'moro init', href: '/docs/cli/init/' },
      { label: 'moro data', href: '/docs/cli/data/' },
      { label: 'moro recipe', href: '/docs/cli/recipe/' },
      { label: 'moro train', href: '/docs/cli/train/' },
      { label: 'moro eval', href: '/docs/cli/eval/' },
      { label: 'moro release', href: '/docs/cli/release/' },
      { label: 'moro flywheel', href: '/docs/cli/flywheel/' },
      { label: 'moro services', href: '/docs/cli/services/' },
      { label: 'moro analytics', href: '/docs/cli/analytics/' },
      { label: 'moro dashboard', href: '/docs/cli/dashboard/' },
      { label: 'moro plugins', href: '/docs/cli/plugins/' },
    ],
  },
  {
    category: 'API Reference',
    items: [
      { label: 'Python SDK Reference', href: '/docs/api/python/' },
      { label: 'Mission Control REST API', href: '/docs/api/rest/' },
      { label: 'Live Telemetry WebSocket', href: '/docs/api/websocket/' },
      { label: 'Plugin & Extensibility API', href: '/docs/api/plugin-api/' },
    ],
  },
  {
    category: 'Production Deployment',
    items: [
      { label: 'Local Ollama Deployment', href: '/docs/deployment/ollama/' },
      { label: 'Docker Containerization', href: '/docs/deployment/docker/' },
      { label: 'Kubernetes & Slurm Clusters', href: '/docs/deployment/kubernetes/' },
      { label: 'Production Best Practices', href: '/docs/deployment/production/' },
    ],
  },
  {
    category: 'Advanced Guides',
    items: [
      { label: 'Troubleshooting & Diagnostics', href: '/docs/guides/troubleshooting/' },
      { label: 'Consumer GPU Performance Tuning', href: '/docs/guides/performance/' },
      { label: 'Air-Gapped & Sovereign Privacy', href: '/docs/guides/privacy/' },
      { label: 'Contributing to MoroAI', href: '/docs/guides/contributing/' },
    ],
  },
];

// Flatten docs to compute breadcrumbs and sequential Prev/Next navigation
const flatDocs = docNav.flatMap((section) =>
  section.items.map((item) => ({ ...item, category: section.category }))
);
const currentIndex = flatDocs.findIndex(
  (d) => d.href === currentSlug || d.href.replace(/\/$/, '') === currentSlug.replace(/\/$/, '')
);
const prevDoc = currentIndex > 0 ? flatDocs[currentIndex - 1] : null;
const nextDoc = currentIndex >= 0 && currentIndex < flatDocs.length - 1 ? flatDocs[currentIndex + 1] : null;
const activeDoc = flatDocs[currentIndex] || { label: title.replace(' — MoroAI Documentation', ''), category: 'Docs' };
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="pt-24 sm:pt-28 pb-20 sm:pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
      {/* Desktop Sidebar Navigation (Hidden on mobile & tablets < lg) */}
      <aside class="hidden lg:block lg:col-span-3">
        <div class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto space-y-6 rounded-2xl border border-dark-800 bg-dark-900/70 p-5 backdrop-blur-xl">
          <div class="flex items-center justify-between border-b border-dark-800 pb-3">
            <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-moro-400 font-bold">
              <BookOpen class="w-4 h-4" />
              <span>Documentation Hub</span>
            </div>
            <span class="text-[10px] font-mono text-gray-500 bg-dark-950 px-2 py-0.5 rounded border border-dark-800">
              v0.1.0
            </span>
          </div>

          <nav class="space-y-6">
            {docNav.map((section) => (
              <div>
                <h4 class="text-[11px] font-mono font-bold uppercase tracking-wider text-gray-500 mb-2">
                  {section.category}
                </h4>
                <ul class="space-y-1 text-xs">
                  {section.items.map((item) => {
                    const isActive =
                      currentSlug === item.href ||
                      currentSlug.replace(/\/$/, '') === item.href.replace(/\/$/, '');
                    return (
                      <li>
                        <a
                          href={item.href}
                          class={`block px-2.5 py-1.5 rounded-lg transition-colors leading-snug ${
                            isActive
                              ? 'bg-moro-500/20 text-moro-300 font-semibold border border-moro-500/30'
                              : 'text-gray-400 hover:text-white hover:bg-dark-800/60'
                          }`}
                        >
                          {item.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      </aside>

      {/* Main Documentation Body (Immediately visible on mobile & tablets) */}
      <article
        class="lg:col-span-9 prose prose-invert max-w-none"
        data-pagefind-filter={currentSlug.includes('/cookbook/') ? 'section:cookbook' : 'section:docs'}
        data-pagefind-meta={currentSlug.includes('/cookbook/') ? 'type:cookbook' : 'type:docs'}
      >
        {/* Mobile & Tablet Interactive Docs Navigation */}
        <MobileDocsNav client:load docNav={docNav} currentSlug={currentSlug} />

        <div class="rounded-3xl border border-dark-800 bg-dark-900/50 p-5 sm:p-8 md:p-12 backdrop-blur-xl shadow-2xl">
          {/* Breadcrumbs */}
          <nav aria-label="Breadcrumb" class="not-prose mb-6 flex items-center gap-2 text-xs font-mono text-gray-400 flex-wrap">
            <a href="/" class="hover:text-white transition-colors flex items-center gap-1">
              <Home class="w-3.5 h-3.5" />
              <span class="sr-only">Home</span>
            </a>
            <ChevronRight class="w-3.5 h-3.5 text-dark-700" />
            <a href="/docs/getting-started/introduction/" class="hover:text-white transition-colors">
              Docs
            </a>
            <ChevronRight class="w-3.5 h-3.5 text-dark-700" />
            <span class="text-gray-400">{activeDoc.category}</span>
            <ChevronRight class="w-3.5 h-3.5 text-dark-700" />
            <span class="text-moro-300 font-semibold" data-pagefind-meta="title">{activeDoc.label}</span>
          </nav>

          {/* Doc Content */}
          <slot />

          {/* Previous / Next Sequential Navigation */}
          <div class="not-prose mt-12 pt-8 border-t border-dark-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevDoc ? (
              <a
                href={prevDoc.href}
                class="p-4 rounded-2xl bg-dark-950/80 border border-dark-800 hover:border-moro-500/40 transition-all flex flex-col group"
              >
                <span class="text-[11px] font-mono text-gray-500 flex items-center gap-1 group-hover:text-moro-400 transition-colors">
                  <ArrowLeft class="w-3 h-3 group-hover:-translate-x-1 transition-transform" />
                  <span>Previous Topic</span>
                </span>
                <span class="text-sm font-bold text-white mt-1 group-hover:text-moro-200 transition-colors">
                  {prevDoc.label}
                </span>
                <span class="text-[10px] text-gray-400 font-mono mt-0.5">
                  {prevDoc.category}
                </span>
              </a>
            ) : (
              <div />
            )}

            {nextDoc ? (
              <a
                href={nextDoc.href}
                class="p-4 rounded-2xl bg-dark-950/80 border border-dark-800 hover:border-moro-500/40 transition-all flex flex-col sm:items-end text-left sm:text-right group"
              >
                <span class="text-[11px] font-mono text-gray-500 flex items-center gap-1 group-hover:text-moro-400 transition-colors">
                  <span>Next Topic</span>
                  <ArrowRight class="w-3 h-3 group-hover:translate-x-1 transition-transform" />
                </span>
                <span class="text-sm font-bold text-white mt-1 group-hover:text-moro-200 transition-colors">
                  {nextDoc.label}
                </span>
                <span class="text-[10px] text-gray-400 font-mono mt-0.5">
                  {nextDoc.category}
                </span>
              </a>
            ) : (
              <div />
            )}
          </div>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
