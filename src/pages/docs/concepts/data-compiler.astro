const title = 'Epistemic Data Compiler & MI Guard — MoroAI Architecture';
const description = 'How MoroAI curates enterprise training datasets using information theory, Shannon entropy, Pointwise Mutual Information, and the Mutual Information Guard.';
---

<DocsLayout title={title} description={description} currentSlug="/docs/concepts/data-compiler/">
  <div class="not-prose mb-8">
    <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider bg-cyan-500/10 px-2.5 py-1 rounded border border-cyan-500/20 mb-3 inline-block">
