---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { ArrowRight, BookOpen, Bot, FileJson, Code, FileText, Stethoscope, Scale } from 'lucide-react';

const title = 'MoroAI Cookbook — Real-World Recipes & Examples';
const description = 'Practical, end-to-end cookbooks for building customer support bots, structured JSON extractors, medical Q&A systems, and code assistants with MoroAI.';

const recipes = [
  {
    title: 'Customer Support Bot',
    desc: 'Fine-tune a model on private Zendesk/Intercom support transcripts with Ollama deployment.',
    href: '/docs/cookbook/support-bot/',
    icon: Bot,
    tag: 'Conversational',
  },
  {
    title: 'Structured JSON Extractor',
    desc: 'Extract strict, deterministic JSON schemas from messy, unstructured invoices and purchase orders.',
    href: '/docs/cookbook/json-extractor/',
    icon: FileJson,
    tag: 'Extraction',
  },
  {
    title: 'Internal Code Assistant',
    desc: 'Adapt a small model on your private GitHub repositories, libraries, and coding standards.',
    href: '/docs/cookbook/code-assistant/',
    icon: Code,
    tag: 'Coding',
  },
  {
    title: 'Document Summarizer',
    desc: 'Long-context distillation for executive memos, technical specifications, and research papers.',
    href: '/docs/cookbook/document-summarizer/',
    icon: FileText,
    tag: 'Summarization',
  },
  {
    title: 'Medical Q&A System',
    desc: 'Preserve clinical terminology and diagnostic contraindications with MI Guard.',
    href: '/docs/cookbook/medical-qa/',
    icon: Stethoscope,
    tag: 'Healthcare',
  },
  {
    title: 'Legal Document Analyzer',
    desc: 'Audit contracts, NDAs, and liability agreements locally without third-party cloud leakage.',
    href: '/docs/cookbook/legal-analyzer/',
    icon: Scale,
    tag: 'Compliance',
  },
];
---

<DocsLayout title={title} description={description} currentSlug="/docs/cookbook/">
  <div class="not-prose mb-8">
    <span class="text-xs font-mono font-bold text-moro-400 uppercase tracking-wider bg-moro-500/10 px-2.5 py-1 rounded border border-moro-500/20 mb-3 inline-block">
      Production Recipes
    </span>
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">MoroAI Cookbook</h1>
    <p class="text-gray-400 text-base mt-2">
      Step-by-step implementation blueprints solving real-world enterprise engineering problems.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose my-8">
    {recipes.map((r) => {
      const Icon = r.icon;
      return (
        <a
          href={r.href}
          class="p-6 rounded-2xl bg-dark-950 border border-dark-800 hover:border-moro-500/40 hover:bg-dark-900/80 transition-all flex flex-col justify-between group shadow-lg"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-moro-500/10 border border-moro-500/20 flex items-center justify-center text-moro-400 group-hover:scale-105 transition-transform">
                <Icon class="w-5 h-5" />
              </div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-gray-400 bg-dark-900 px-2 py-0.5 rounded border border-dark-800">
                {r.tag}
              </span>
            </div>
            <h3 class="text-base font-bold text-white mb-2 group-hover:text-moro-300 transition-colors">
              {r.title}
            </h3>
            <p class="text-xs text-gray-400 leading-relaxed">{r.desc}</p>
          </div>
          <div class="pt-4 mt-4 border-t border-dark-900 flex items-center gap-1.5 text-xs font-semibold text-moro-400 group-hover:text-moro-300">
            <span>View Recipe</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      );
    })}
  </div>
</DocsLayout>
