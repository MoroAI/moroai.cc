---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Tag, Sparkles, CheckCircle2, GitCommit, ArrowUpRight } from 'lucide-react';

const title = 'Changelog & Releases — MoroAI Updates';
const description = 'Track version releases, new features, and technical enhancements to the MoroAI local model adaptation engine.';

const releases = [
  {
    version: 'v0.1.0',
    date: 'September 2026',
    title: 'The Sovereign AI Foundation Release',
    tag: 'Latest Production Release',
    summary:
      'The initial general availability release of the MoroAI local model adaptation platform. Assembles 19 subsystems into a single executable runtime with 414 passing unit and integration tests.',
    features: [
      'Epistemic Data Compiler with Shannon entropy filtering and MI Guard edge-case protection',
      'Hardware-aware Recipe Predictor with pre-flight VRAM memory simulation',
      '5-step self-healing training engine with autonomous OOM recovery and loss rollback',
      'Multi-layered evaluation suite with deterministic gates, LLM judges, and Wasserstein drift bounds',
      'Cryptographic Release Governance generating signed Software Bills of Materials (SBOM)',
      'Mission Control reactive web dashboard with dataset drag-and-drop and live telemetry',
      'Closed-loop DPO Feedback Flywheel for continuous local model alignment',
      'One-click Ollama export with GGUF quantization (Q4_K_M, Q8_0)',
      'Published on PyPI as moroai==0.1.0 with verified wheel distributions',
    ],
    githubRelease: 'https://github.com/moroai/moro/releases/tag/v0.1.0',
  },
];
---

<BaseLayout title={title} description={description}>
  <main class="pt-32 pb-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Header */}
      <div class="text-center max-w-2xl mx-auto mb-20">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-moro-500/10 border border-moro-500/20 text-moro-400 text-xs font-semibold uppercase tracking-wider mb-6">
          <Tag class="w-3.5 h-3.5" />
          <span>Release History</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Changelog
        </h1>
        <p class="text-base sm:text-lg text-gray-300">
          Continuous improvements, new deployment targets, and engine stability updates.
        </p>
      </div>

      {/* Release Timeline */}
      <div class="space-y-12">
        {releases.map((rel) => (
          <div class="rounded-3xl border border-dark-800 bg-dark-900/60 p-8 sm:p-10 backdrop-blur-xl shadow-xl">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-dark-800 pb-6 mb-6">
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-2xl font-black text-white">{rel.version}</span>
                  <span class="text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full">
                    {rel.tag}
                  </span>
                </div>
                <div class="text-xs text-gray-400 font-mono">{rel.date}</div>
              </div>

              <a
                href={rel.githubRelease}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-dark-800 hover:bg-dark-700 text-xs font-semibold text-white border border-dark-700 transition-colors"
              >
                <span>View Release on GitHub</span>
                <ArrowUpRight class="w-3.5 h-3.5" />
              </a>
            </div>

            <h3 class="text-xl font-bold text-white mb-3">{rel.title}</h3>
            <p class="text-sm text-gray-300 leading-relaxed mb-6">{rel.summary}</p>

            <h4 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold mb-4">
              Highlights & Shipped Modules
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              {rel.features.map((feat) => (
                <div class="flex items-start gap-2.5 text-gray-300 bg-dark-950/80 p-3 rounded-xl border border-dark-800/80">
                  <CheckCircle2 class="w-4 h-4 text-moro-400 shrink-0 mt-0.5" />
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
