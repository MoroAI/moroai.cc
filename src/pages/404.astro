---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Home, Terminal, ArrowRight, Compass } from 'lucide-react';

const title = '404 - Page Not Found — MoroAI';
const description = 'The page you requested could not be found.';
---

<BaseLayout title={title} description={description}>
  <main class="min-h-[75vh] flex items-center justify-center pt-24 pb-16 px-4">
    <div class="text-center max-w-lg mx-auto">
      <div class="w-16 h-16 rounded-2xl bg-moro-500/10 border border-moro-500/20 flex items-center justify-center text-moro-400 mx-auto mb-6">
        <Compass class="w-8 h-8" />
      </div>
      <span class="text-xs font-mono font-bold text-moro-400 uppercase tracking-widest bg-dark-900 border border-dark-800 px-3 py-1 rounded-full mb-4 inline-block">
        Error 404
      </span>
      <h1 class="text-4xl font-black text-white mb-4">Coordinates Not Found</h1>
      <p class="text-sm text-gray-400 mb-8 leading-relaxed">
        The documentation page or resource you are seeking may have moved or been renamed in our latest release.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-moro-500 hover:bg-moro-400 text-white font-semibold text-sm transition-colors flex items-center justify-center gap-2"
        >
          <Home class="w-4 h-4" />
          <span>Return Home</span>
        </a>
        <a
          href="/docs/getting-started/quickstart/"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-dark-900 hover:bg-dark-800 text-gray-200 border border-dark-700 font-semibold text-sm transition-colors flex items-center justify-center gap-2"
        >
          <Terminal class="w-4 h-4" />
          <span>Read Quickstart</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
